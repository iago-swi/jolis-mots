{
  "name": "@jolis-mots/desktop",
  "version": "1.0.7",
  "productName": "Jolis Mots",
  "private": true,
  "type": "module",
  "description": "Jolis Mots — des mots français rares",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "electron .",
    "package": "node package.mjs",
    "icons": "node make-icons.mjs"
  },
  "devDependencies": {
    "@jolis-mots/core": "*",
    "electron": "45.4.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "ch.noth.jolismots",
    "productName": "Jolis Mots",
    "electronVersion": "45.4.1",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Jolis Mots",
      "artifactName": "Jolis-Mots-${version}-setup.${ext}"
    },
    "artifactName": "Jolis-Mots-${version}-${arch}.${ext}",
    "portable": {
      "artifactName": "Jolis-Mots-${version}-portable.${ext}"
    }
  },
  "author": "Philippe Noth"
}
